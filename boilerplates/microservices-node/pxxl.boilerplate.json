{
  "id": "microservices-node",
  "family": "microservices",
  "displayName": "Microservices",
  "description": "API and background worker services in one Pxxl project.",
  "language": "node",
  "framework": "express",
  "packageManager": "pnpm",
  "runtime": "node",
  "port": 3000,
  "installCommand": "pnpm install",
  "buildCommand": "",
  "startCommand": "node server.js",
  "services": [
    {
      "alias": "api",
      "baseDirectory": "services/api",
      "port": 3000,
      "serviceType": "api",
      "route": true,
      "installCommand": "pnpm install",
      "startCommand": "node server.js"
    },
    {
      "alias": "worker",
      "baseDirectory": "services/worker",
      "port": 3001,
      "serviceType": "worker",
      "route": false,
      "installCommand": "pnpm install",
      "startCommand": "node worker.js"
    }
  ]
}
